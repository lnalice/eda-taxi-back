# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer groups
USER_SERVICE_CONSUMER_GROUP=user-service
DRIVER_SERVICE_CONSUMER_GROUP=driver-service
TAXI_PLATFORM_CONSUMER_GROUP=taxi-platform
TAXI_PLATFORM_DLT_CONSUMER_GROUP=taxi-platform-dlt-monitor

# Topic names
TOPIC_CALL=Call
TOPIC_CALL_RESPONSE=CallResponse
TOPIC_TAXI_LOCATION=TaxiLocation
TOPIC_RIDE=Ride
TOPIC_RIDE_RESPONSE=RideResponse
TOPIC_PICK_UP=PickUp
TOPIC_DROP_OFF=DropOff
TOPIC_CALL_DLT=Call.DLT
TOPIC_CALL_RESPONSE_DLT=CallResponse.DLT
TOPIC_TAXI_LOCATION_DLT=TaxiLocation.DLT
TOPIC_RIDE_DLT=Ride.DLT
TOPIC_RIDE_RESPONSE_DLT=RideResponse.DLT
TOPIC_PICK_UP_DLT=PickUp.DLT
TOPIC_DROP_OFF_DLT=DropOff.DLT

# Retry policy
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_INITIAL_INTERVAL_MS=1000
KAFKA_RETRY_MULTIPLIER=2.0
KAFKA_RETRY_MAX_INTERVAL_MS=10000

# Service ports (optional override)
# SERVER_PORT=8080
